PORT=3000
DATABASE_URL=file:./dev.db

# Google Cloud project with Cloud Translation API enabled.
GOOGLE_CLOUD_PROJECT_ID=

# Simplest setup for this personal app: a Google Cloud Translation API key.
# Restrict the key to the Cloud Translation API in Google Cloud Console.
GOOGLE_TRANSLATE_API_KEY=

# Base64-encoded service-account JSON. Generate it with:
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# Linux/macOS: base64 -w 0 service-account.json
GOOGLE_CLOUD_CREDENTIALS_BASE64=

# For local Application Default Credentials, leave the base64 value empty and
# point this at a service-account JSON file instead. Do not commit that file.
GOOGLE_APPLICATION_CREDENTIALS=
